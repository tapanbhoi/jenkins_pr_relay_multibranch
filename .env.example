WEBHOOK_PROVIDER=github
WEBHOOK_SECRET=change-this-to-a-long-random-secret

JENKINS_URL=http://jenkins:8080
JENKINS_USER=jenkins-user
JENKINS_API_TOKEN=jenkins-api-token
JENKINS_MULTIBRANCH_JOB=my-folder/my-repo

# scan: trigger the multibranch project to rescan repo branches and PRs.
# branch-build: trigger an already-discovered PR branch job such as PR-12.
JENKINS_TRIGGER_MODE=scan
JENKINS_BRANCH_JOB_PREFIX=PR-
JENKINS_VERIFY_TLS=true
REQUEST_TIMEOUT_SECONDS=20
