WEBHOOK_PROVIDER=github
WEBHOOK_SECRET=change-this-to-a-long-random-secret

# GitHub Personal Access Token for posting PR comments and commit statuses
# Required scopes: repo (full control of private repositories)
# Generate from: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

JENKINS_URL=http://jenkins:8080
JENKINS_USER=jenkins-user
JENKINS_API_TOKEN=jenkins-api-token

# Jenkins multibranch job name (e.g., "torch-spyre" or "folder/torch-spyre")
JENKINS_MULTIBRANCH_JOB=torch-spyre

# scan: trigger the multibranch project to rescan repo branches and PRs.
# branch-build: trigger an already-discovered PR branch job such as PR-12.
JENKINS_TRIGGER_MODE=scan
JENKINS_BRANCH_JOB_PREFIX=PR-
JENKINS_VERIFY_TLS=true
REQUEST_TIMEOUT_SECONDS=20

# Jenkins polling configuration for monitoring build results
JENKINS_POLL_INTERVAL_SECONDS=10
JENKINS_POLL_TIMEOUT_SECONDS=3600
